# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# React Native Firebase resolves Firebase through Swift Package Manager. The
# Firebase products must be dynamic here; static Pods duplicate their symbols.
use_frameworks! :linkage => :dynamic

target 'ServeUp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-image-picker imports legacy and current UTType APIs without
    # declaring their frameworks. With dynamic Pods (required by React Native
    # Firebase's SPM integration), that omission becomes an arm64 linker error.
    image_picker_target = installer.pods_project.targets.find { |target| target.name == 'react-native-image-picker' }
    if image_picker_target
      image_picker_target.build_configurations.each do |build_configuration|
        other_ldflags = build_configuration.build_settings['OTHER_LDFLAGS'] || '$(inherited)'
        %w[MobileCoreServices UniformTypeIdentifiers].each do |framework|
          unless other_ldflags.include?(framework)
            other_ldflags = "#{other_ldflags} -framework #{framework}"
          end
        end
        build_configuration.build_settings['OTHER_LDFLAGS'] = other_ldflags
      end
    end

    # MapLibre ships its native SDK as a Swift package; this hook adds it to the Pods
    # project and to the app target, otherwise MapLibre/MapLibre.h is not found.
    $MLRN.post_install(installer)
  end
end
